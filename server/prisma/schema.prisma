generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tea_Product {
  id          Int            @id @default(autoincrement())
  title       String
  description String
  price       Float
  flavour     Flavour[]
  category    Tea_Category[]
}

model Flavour {
  id             Int          @id @default(autoincrement())
  flavourName    String       @unique
  prod_flavour   Tea_Product? @relation(fields: [prod_flavourId], references: [id])
  prod_flavourId Int?
}

model Tea_Category {
  id            Int          @id @default(autoincrement())
  catName       String       @unique
  prod_category Tea_Product? @relation(fields: [prod_catId], references: [id])
  prod_catId    Int?
}

model User_Details {
  id         Int    @id @default(autoincrement())
  email      String @unique
  firstName  String
  lastName   String
  country    String
  region     String
  address    String
  city       String
  postalCode Int
  phonNumber Int
}

model Order {
  id                  Int      @id @default(autoincrement())
  // tea_product
  userShippingDetails String
  // userDetails
  totalAmount         Float
  paymentMethod       String
  orderDateTime       DateTime
}
