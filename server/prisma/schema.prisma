generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tea_Product {
  id          Int          @id @default(autoincrement())
  title       String
  description String
  price       Float
  flavour     Flavour      @relation(fields: [flavourId], references: [id])
  flavourId   Int
  category    Tea_Category @relation(fields: [categoryId], references: [id])
  categoryId  Int
}

model Flavour {
  id          Int           @id @default(autoincrement())
  flavourName String        @unique
  teaProducts Tea_Product[]
}

model Tea_Category {
  id          Int           @id @default(autoincrement())
  catName     String        @unique
  teaProducts Tea_Product[]
}

model User_Details {
  id         Int    @id @default(autoincrement())
  email      String @unique
  firstName  String
  lastName   String
  country    String
  region     String
  address    String
  city       String
  postalCode Int
  phonNumber Int
}

model Order {
  id                  Int      @id @default(autoincrement())
  // tea_product
  userShippingDetails String
  // userDetails
  totalAmount         Float
  paymentMethod       String
  orderDateTime       DateTime
}
